{
  "name": "smooth-caret",
  "version": "1.3.5",
  "description": "Give the Obsidian editor caret a smooth, VS Code-style glide between positions.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/* --format=cjs --platform=browser --target=es2018 --outfile=main.js",
    "dev": "npm run build -- --watch"
  },
  "dependencies": {
    "@codemirror/view": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
